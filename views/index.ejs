<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Todo Manager</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:linear-gradient(135deg,#0f172a,#1e293b,#312e81);
display:flex;
justify-content:center;
align-items:center;
height:100vh;
color:white;
}

.container{
width:90%;
max-width:650px;
background:rgba(255,255,255,.08);
backdrop-filter:blur(10px);
border-radius:20px;
padding:50px;
text-align:center;
box-shadow:0 10px 40px rgba(0,0,0,.4);
}

h1{
font-size:42px;
margin-bottom:20px;
}

span{
color:#a855f7;
}

p{
font-size:18px;
line-height:1.7;
margin-bottom:40px;
color:#d1d5db;
}

.buttons{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

a{
text-decoration:none;
padding:15px 35px;
border-radius:10px;
font-weight:bold;
transition:.3s;
}

.login{
background:#9333ea;
color:white;
}

.login:hover{
background:#7e22ce;
}

.register{
background:#10b981;
color:white;
}

.register:hover{
background:#059669;
}

.tasks{
background:#f59e0b;
color:white;
}

.tasks:hover{
background:#d97706;
}

.footer{
margin-top:35px;
font-size:14px;
color:#cbd5e1;
}

</style>

</head>

<body>

<div class="container">

<h1>Todo <span>Manager</span></h1>

<p>

Organize your daily activities, monitor deadlines,
receive real-time notifications,
and never miss an important task again.

</p>

<div class="buttons">

<a href="/auth/login" class="login">

Login

</a>

<a href="/auth/register" class="register">

Register

</a>

<a href="/tasks" class="tasks">

My Tasks

</a>

</div>

<div class="footer">

<strong>CHEESOM</strong> Task Management System © 2026

</div>

</div>

</body>

</html>