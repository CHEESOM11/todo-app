<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Tasks</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:linear-gradient(135deg,#0f172a,#1e293b,#312e81);
padding:40px;
color:white;
}

.container{
max-width:900px;
margin:auto;
}

h1{
text-align:center;
margin-bottom:30px;
}

form.add-task{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:30px;
}

input{
padding:14px;
border:none;
border-radius:10px;
font-size:15px;
}

input[type="text"]{
flex:2;
}

input[type="date"]{
flex:1;
}

.addBtn{
background:#9333ea;
color:white;
padding:14px 25px;
border:none;
border-radius:10px;
cursor:pointer;
font-weight:bold;
}

.addBtn:hover{
background:#7e22ce;
}

.menu{
margin-bottom:30px;
display:flex;
gap:15px;
flex-wrap:wrap;
}

.menu a{
text-decoration:none;
color:white;
background:#334155;
padding:10px 18px;
border-radius:8px;
}

.menu a:hover{
background:#9333ea;
}

.card{
background:#1e293b;
padding:20px;
border-radius:15px;
margin-bottom:20px;
box-shadow:0 5px 15px rgba(0,0,0,.3);
}

.status{
padding:5px 10px;
border-radius:6px;
font-size:14px;
font-weight:bold;
}

.pending{
background:#f59e0b;
}

.completed{
background:#22c55e;
}

.overdue{
background:#ef4444;
}

.buttons{
margin-top:15px;
display:flex;
gap:10px;
flex-wrap:wrap;
}

.buttons button{
padding:10px 18px;
border:none;
border-radius:8px;
cursor:pointer;
color:white;
}

.complete{
background:#22c55e;
}

.reopen{
background:#f59e0b;
}

.delete{
background:#ef4444;
}

small{
color:#cbd5e1;
display:block;
margin-top:10px;
}

.message{
padding:12px 16px;
border-radius:8px;
margin-bottom:20px;
font-weight:bold;
}

.success{
background:#14532d;
color:#dcfce7;
}

.error{
background:#7f1d1d;
color:#fee2e2;
}

</style>

</head>

<body>

<div class="container">

<h1>My Tasks</h1>

<% if (message) { %>
  <div class="message success"><%= message %></div>
<% } %>

<% if (error) { %>
  <div class="message error"><%= error %></div>
<% } %>

<form class="add-task" method="POST" action="/tasks">

<input
type="text"
name="description"
placeholder="Enter task description"
required>

<input
type="date"
name="dueDate"
required>

<button class="addBtn">

Add Task

</button>

</form>

<div class="menu">

<a href="/tasks">All</a>

<a href="/tasks?status=pending">Pending</a>

<a href="/tasks?status=completed">Completed</a>

<a href="/tasks?status=overdue">Overdue</a>

<a href="/auth/logout">Logout</a>

</div>

<% tasks.forEach(task => { %>

<div class="card">

<h3><%= task.description %></h3>

<small>

Due Date:

<%= task.dueDate ? new Date(task.dueDate).toDateString() : "Not Set" %>

</small>

<br>

<span class="status <%= task.status %>">

<%= task.status.toUpperCase() %>

</span>

<% if(task.status !== "deleted"){ %>

<div class="buttons">

<% if(task.status === "pending"){ %>

<form method="POST" action="/tasks/<%= task._id %>/complete">
  <button class="complete" type="submit">Complete</button>
</form>

<% } %>

<% if(task.status === "completed"){ %>

<form method="POST" action="/tasks/<%= task._id %>">
  <input type="hidden" name="status" value="pending">
  <button class="reopen" type="submit">Re-Open</button>
</form>

<% } %>

<form method="POST" action="/tasks/<%= task._id %>/delete">
  <button class="delete" type="submit">Delete</button>
</form>

</div>

<% } %>

</div>

<% }) %>

</div>

</body>

</html>